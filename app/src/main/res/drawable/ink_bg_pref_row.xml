<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle"><solid android:color="@color/btn_bg_press" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><solid android:color="@color/btn_bg_press" /></shape>
    </item>
    <item>
        <layer-list>
            <item android:gravity="bottom" android:left="20dp" android:height="0.5dp">
                <shape android:shape="rectangle"><solid android:color="@color/ink_line" /></shape>
            </item>
        </layer-list>
    </item>
</selector>
